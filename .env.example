# Copy this file to .env for local development. Never commit .env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/teddyxmd
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
NODE_ENV=development
# Optional; leave blank until you have an approved TikTok Login Kit app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
